# Supabase project. Auth uses the anon key. The server uses the service role for private documents.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string from Supabase. Use the pooler URI (port 6543) on Vercel.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# Signs the guest share cookie. Account sessions are Supabase cookies.
SESSION_SECRET=replace-with-a-long-random-string

# Sends the one-time code to a guest inbox. MAIL_FROM must be a verified Resend sender.
RESEND_API_KEY=re_your_key
MAIL_FROM="Reveal <trips@your-domain>"
